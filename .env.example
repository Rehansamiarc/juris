# AI provider (optional — the app runs in local extractive mode without it).
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, Together,
# Google AI Studio's OpenAI-compatible endpoint, or a local Ollama server.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini

# Optional: use a separate, stronger model for case briefs.
AI_BRIEF_MODEL=

# Session cookie name / app origin
APP_ORIGIN=http://localhost:3000

# Throwaway database for `npm run smoke`. The run truncates every table in it,
# so it must never point at the database above.
SMOKE_DATABASE_URL=
